import "io";
import "http";
import "html";
import "layout.may";
import "index.may";
import "about.may";

int server = create_server(8080);
print("Server running on port 8080");

while (1) {
    int client = accept_client(server);
    object req = read_request(client);
    print(req->method + " " + req->path);
    send_html(client, layout(router(req, {
        "/": home(),
        "/about": about()
    })));
}

